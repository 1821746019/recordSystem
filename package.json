{
  "name": "student-print-record-system",
  "version": "1.0.0",
  "private": true,
  "description": "学生打印记录系统：记录单面/双面打印张数，自动计价、结算与统计。核心逻辑与界面分离，便于迁移到微信小程序。",
  "scripts": {
    "test": "node tests/run.js",
    "test:core": "node tests/core.test.js",
    "test:ui": "node tests/ui-smoke.test.js",
    "test:pwa": "node tests/pwa.test.js",
    "test:sw": "node tests/sw.test.js",
    "vendor:pinyin": "node tools/vendor-pinyin.js",
    "icons:emoji": "node tools/render-emoji-icon.js apply",
    "icons:preview": "node tools/render-emoji-icon.js compose",
    "icons:fallback": "node tools/make-icons.js",
    "serve": "python3 -m http.server 8080"
  },
  "keywords": ["打印", "记录", "计价", "记账", "微信小程序"],
  "license": "MIT"
}